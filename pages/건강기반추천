CLIENT_SECRET = st.secrets.get("GOOGLE_CLIENT_SECRET", "") if hasattr(st, "secrets") else ""
REDIRECT_URI = st.secrets.get("REDIRECT_URI", "http://localhost:8501") if hasattr(st, "secrets") else "http://localhost:8501"

